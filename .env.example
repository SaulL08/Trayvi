# Copying this file is intentionally insufficient: secret fields are blank.
# Run scripts/local/initialize-environment.ps1 to create random local-only files.
NODE_ENV=development
SERVICE_NAME=
SERVICE_VERSION=dev
HOST=127.0.0.1
PORT=3000
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_TLS_MODE=disable
DATABASE_TLS_CA=
DATABASE_READY_TIMEOUT_MS=1000
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_TIMEOUT_MS=2000
METRICS_ENABLED=true
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_MAX_URL_LENGTH=2048
HTTP_MAX_HEADER_SIZE_BYTES=16384
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_CONNECTION_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
