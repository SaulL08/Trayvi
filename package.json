{
  "name": "trayvi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Trayvi Phase 0 engineering foundation",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "dev:api": "pnpm --filter @trayvi/api dev",
    "dev:worker": "pnpm --filter @trayvi/worker dev",
    "local:env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/initialize-environment.ps1",
    "local:db:up": "docker compose --env-file .env.local -f infra/local/compose.yaml up -d --wait",
    "local:db:down": "docker compose --env-file .env.local -f infra/local/compose.yaml down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:local": "node --env-file=.env.api node_modules/vitest/vitest.mjs run --project integration",
    "test:coverage": "vitest run --coverage",
    "architecture:check": "tsx scripts/architecture/check-boundaries.ts",
    "security:secrets": "tsx scripts/security/scan-secrets.ts",
    "security:dependencies": "pnpm audit --audit-level high",
    "security:licenses": "tsx scripts/security/check-licenses.ts",
    "db:migrate": "tsx scripts/db/migrate.ts up",
    "db:migrate:local": "node --env-file=.env.api --import tsx scripts/db/migrate.ts up",
    "db:status": "tsx scripts/db/migrate.ts status",
    "db:down": "tsx scripts/db/migrate.ts down",
    "db:verify": "tsx scripts/db/verify.ts",
    "db:verify:local": "node --env-file=.env.api --import tsx scripts/db/verify.ts",
    "verify": "pnpm toolchain:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm security:secrets && pnpm security:licenses && pnpm test:unit && pnpm build",
    "verify:full": "pnpm verify && pnpm test:integration && pnpm db:verify && pnpm security:dependencies",
    "toolchain:check": "tsx scripts/check-toolchain.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.1",
    "eslint": "10.9.1",
    "pnpm": "11.25.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.1"
  }
}
