FROM postgis/postgis:17-3.5-alpine@sha256:894f570c0cf0664ed5576a8fd5d5bfb8fb1b19d592885b686c3a88c8bd90c41f AS hardened

USER root
RUN --mount=type=secret,id=local_ca,required=false \
    if [ -s /run/secrets/local_ca ]; then \
      cp /run/secrets/local_ca /usr/local/share/ca-certificates/local-development-ca.crt; \
      update-ca-certificates; \
    fi \
    && apk add --no-cache --upgrade 'libexpat=2.8.5-r0' 'libuuid=2.42.3-r1' 'su-exec=0.3-r0' \
    && rm -f /usr/local/bin/gosu /usr/local/share/ca-certificates/local-development-ca.crt \
    && ln -s /sbin/su-exec /usr/local/bin/gosu \
    && update-ca-certificates

# Flatten the final root filesystem so the removed Go binary is absent from every shipped layer.
FROM scratch
COPY --from=hardened / /

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=en_US.utf8 \
    PG_MAJOR=17 \
    PG_VERSION=17.11 \
    PGDATA=/var/lib/postgresql/data \
    POSTGIS_VERSION=3.5.7

LABEL maintainer="PostGIS Project - https://postgis.net" \
      org.opencontainers.image.description="Trayvi Phase 0 hardened PostGIS 3.5.7 with PostgreSQL 17.11 Alpine" \
      org.opencontainers.image.source="https://github.com/postgis/docker-postgis"

VOLUME /var/lib/postgresql/data
EXPOSE 5432
USER 70:70
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]
STOPSIGNAL SIGINT
