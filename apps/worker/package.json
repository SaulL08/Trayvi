{
  "name": "@trayvi/worker",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --env-file=../../.env.worker --import tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@trayvi/config": "workspace:*",
    "@trayvi/observability": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
