{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@trayvi/accounts": ["./modules/accounts/src/index.ts"],
      "@trayvi/config": ["./packages/config/src/index.ts"],
      "@trayvi/identity": ["./modules/identity/src/index.ts"],
      "@trayvi/observability": ["./packages/observability/src/index.ts"],
      "@trayvi/test-support": ["./packages/test-support/src/index.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "vitest.config.ts", "eslint.config.mjs"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "infra/database/fixtures",
    "scripts/architecture/fixtures/alias-workspace"
  ]
}
